---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://iamrango.com/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  {% for page in site.pages %}
    {% if page.sitemap != false and page.url != "/404.html" and page.url != "/404" and page.url != "/index.html" and page.url != "/" %}
      {% assign page_url = page.url | replace: '.html', '' %}
      {% if page_url != '/sitemap.xml' and page_url != '/_redirects' and page_url != '/.htaccess' %}
  <url>
    <loc>https://iamrango.com{{ page_url }}</loc>
    <lastmod>{% if page.last_reviewed %}{{ page.last_reviewed | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>{% if page.layout == 'tool' %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if page.layout == 'tool' %}0.9{% elsif page.layout == 'guide' %}0.8{% else %}0.6{% endif %}</priority>
  </url>
      {% endif %}
    {% endif %}
  {% endfor %}
</urlset>
