# Apache Rewrite Rules for IMRango (https://iamrango.com)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect trailing slash to slashless (except directories)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)/$ /$1 [L,R=301]

  # Redirect .html to slashless
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
  RewriteRule ^ %1 [R=301,L]

  # Internal rewrite: resolve extensionless URLs to .html files if they exist
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
